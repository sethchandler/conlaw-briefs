-\section{Case Metadata}
-
-\begin{description}
-    \item[Case Name:] \textit{Shelley v. Kraemer} (consolidated with \textit{McGhee v. Sipes}, No.~87)
-    \item[Citation:] \href{https://supreme.justia.com/cases/federal/us/334/1/}{334 U.S. 1 (1948)} (Docket Nos.~72 and 87; \href{https://www.oyez.org/cases/1940-1955/334us1}{Oyez Case Summary})
-    \item[Court:] Supreme Court of the United States
-    \item[Dates:] Argued January 15--16, 1948; Decided May 3, 1948
-    \item[Chapter:] Reconstruction Amendments \& State Action
-    \item[Vote:] 6--0 (unanimous among participating Justices), with 3 recusals
-    \item[Opinion Author:] Chief Justice Fred M. Vinson (joined by Justices Hugo L. Black, Felix Frankfurter, William O. Douglas, Frank Murphy, and Harold H. Burton)

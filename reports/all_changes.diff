-\section{Case Metadata}
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{Flast v. Cohen}
-  \item \textbf{Citation:} 392 U.S. 83 (1968) (No. 416); \href{https://supreme.justia.com/cases/federal/us/392/83/}{Justia Opinion}; \href{https://www.law.cornell.edu/constitution-conan/article-3/section-2/clause-1/taxpayer-standing}{Cornell LII Constitution Annotated}
-  \item \textbf{Dates:} Argued March 12, 1968; Decided June 10, 1968
-  \item \textbf{Lower Court:} Three-judge U.S. District Court for the Southern District of New York, 271 F. Supp. 1 (S.D.N.Y. 1967) (dismissed for lack of standing under \textit{Frothingham v. Mellon}; Judge Frankel dissenting; direct appeal under 28 U.S.C. \S\ 1253)
-  \item \textbf{Vote:} 8--1 (Reversed)
-  \item \textbf{Author:} Chief Justice Warren (joined by Justices Black, Douglas, Brennan, Stewart, White, Fortas, and Marshall)
-  \item \textbf{Concurrences:} Justice Douglas; Justice Stewart; Justice Fortas

-\section{Case Metadata}
-
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{United States v. Belmont} (full caption: \textit{United States v. Belmont et al., Executors})
-  \item \textbf{Citation:} \href{https://supreme.justia.com/cases/federal/us/301/324/}{301 U.S. 324 (1937)}
-  \item \textbf{Court and Dates:} Supreme Court of the United States; argued March 4, 1937; decided May 3, 1937
-  \item \textbf{Chapter:} Chapter 2: Separation of Powers and the Executive
-  \item \textbf{Vote:} 9--0 in judgment (Majority: Sutherland, J., joined by Hughes, C.J., and Van Devanter, McReynolds, Butler, and Roberts, JJ.; Concurring in judgment: Stone, J., joined by Brandeis and Cardozo, JJ.)

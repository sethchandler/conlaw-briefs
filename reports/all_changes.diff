-\section{Case Metadata}
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{United States Steel Corp. v. Multistate Tax Commission}
-  \item \textbf{Citation:} 434 U.S. 452 (1978) (No. 76-635); \href{https://supreme.justia.com/cases/federal/us/434/452/}{Justia Opinion}; \href{https://www.law.cornell.edu/supremecourt/text/434/452}{Cornell LII Opinion}
-  \item \textbf{Dates:} Argued October 11, 1977; Decided February 21, 1978
-  \item \textbf{Lower Court:} Three-judge U.S. District Court for the Southern District of New York, 417 F. Supp. 795 (S.D.N.Y. 1976) (summary judgment for defendants; direct appeal under 28 U.S.C. \S\ 2281)
-  \item \textbf{Vote:} 7--2 (Affirmed)
-  \item \textbf{Author:} Justice Powell (joined by Chief Justice Burger and Justices Brennan, Stewart, Marshall, Rehnquist, and Stevens)

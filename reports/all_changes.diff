-\section{Case Metadata}
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{Baker v. General Motors Corp.}, 522 U.S. 222 (1998) (No.~96-653)
-  \item \textbf{Chapter:} Chapter 4: Federalism and State Sovereignty
-  \item \textbf{Court and Dates:} Supreme Court of the United States; argued October 15, 1997; decided January 13, 1998

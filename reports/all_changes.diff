-\section{Case Metadata}
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{Poindexter v. Greenhow} (lead decision of the \textit{Virginia Coupon Cases})
-  \item \textbf{Citation:} \href{https://supreme.justia.com/cases/federal/us/114/270/}{114 U.S. 270} (\href{https://www.law.cornell.edu/supremecourt/text/114/270}{5 S. Ct. 903; 29 L. Ed. 185}) (1885)

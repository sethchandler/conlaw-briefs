-\section{Case Metadata}
-
-\begin{itemize}
-    \item \textbf{Case Name:} \textit{Cedar Point Nursery et al. v. Victoria Hassid et al.}
-    \item \textbf{Citation:} 594 U.S. 139 (2021) (Docket No.~20--107)
-    \item \textbf{Court:} Supreme Court of the United States (on writ of certiorari to the U.S. Court of Appeals for the Ninth Circuit)
-    \item \textbf{Dates:} Certiorari granted November 13, 2020; argued March 22, 2021; decided June 23, 2021
-    \item \textbf{Vote:} 6--3

-\section{Case Metadata}
-\begin{itemize}
-  \item \textbf{Case Name:} \textit{United States v. E.C. Knight Co.}, 156 U.S. 1 (1895) (No.~675)
-  \item \textbf{Chapter:} Chapter 3: Federal Legislative Power
-  \item \textbf{Court and Dates:} Supreme Court of the United States; argued October 24, 1894; decided January 21, 1895
